# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# LLM Providers (Configure at least one)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
OCR_API_KEY=

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true
# On-device "AI cursor": a glowing blue pointer with an "AI" tag shown at every
# tap/swipe the agent makes, so you can watch it work on the phone itself.
ARTEMIS_AI_CURSOR=true

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash

# ==============================================================================
# Laya Decision Engine (Optional - fast semantic search for element matching
# and history recall; see `artemis laya` for live status)
# ==============================================================================
# auto (default): use a running Laya server when available, otherwise score
#   locally (lexical). Never spends API tokens.
# laya: require the Laya server. openai: opt into one small selection call per
#   rescue on the OpenAI-compatible endpoint above. lexical/off: disable.
#ARTEMIS_DECISION_BACKEND=auto
# Laya (laya-mlx) "System One" decision server; Apple Silicon hosts serve
# 127.0.0.1:8081 by default (pip install 'laya-mlx[serve]' && laya-mlx-serve).
#ARTEMIS_LAYA_URL=http://127.0.0.1:8081
#ARTEMIS_LAYA_API_KEY=
#ARTEMIS_DECISION_MODEL=laya-421m
# Chat model for the `openai` backend (must exist on your endpoint).
#ARTEMIS_DECISION_OPENAI_MODEL=gemini-3.6-flash
#ARTEMIS_DECISION_TIMEOUT=3.0
#ARTEMIS_DECISION_MIN_CONFIDENCE=0.72
#ARTEMIS_DECISION_RESCUE_LIMIT=120
